# Relay Bot environment example
# Copy to .env and replace placeholder values. Do not commit .env.

# Required Discord bot token
BOT_TOKEN=your_bot_token_here

# Optional command fallback prefix
BOT_PREFIX=!

# Dashboard API heartbeat target
API_BASE_URL=http://localhost:3001
RELAY_HEARTBEAT_SECRET=change_this_to_match_relay_website
HEARTBEAT_INTERVAL=30

# Runtime storage paths
# For Docker: mount ./data at /app/data and use /app/data paths
# For local dev: defaults work (relative to repository root)
DATABASE_PATH=./data/relay.db
TRANSCRIPT_DIR=./data/transcripts
FONT_DIR=./data/fonts

# Scheduler intervals
INACTIVITY_THRESHOLD=86400
INACTIVITY_CHECK_INTERVAL=600
RENAME_RESYNC_INTERVAL=15
AUTOCLOSE_CHECK_INTERVAL=30
